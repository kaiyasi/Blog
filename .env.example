# Shared by mascot dialogue and incremental article translation.
# Keep the base URL and models fixed; rotate only AI_API_KEY when needed.
AI_BASE_URL=https://ai.kot.gg/v1
AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
AI_API_KEY=
AI_MASCOT_REASONING_EFFORT=low
AI_TRANSLATION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Persistent SQLite file used by comments and private friend requests.
# Mount this path on durable storage in production.
COMMUNITY_DB_PATH=./data/community.sqlite
COMMUNITY_SESSION_SECRET=

# Private administration. Ten rapid mascot clicks create a short-lived random entrance.
# Use a unique password and a random secret of at least 32 characters.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional writable, persistent directory for browser-authored Markdown posts.
# Defaults to ./src/content/posts.
CONTENT_POSTS_DIRECTORY=
CONTENT_ABOUT_FILE=

# Commit browser-authored content through repository file APIs.
# Keep tokens in server-side secrets only. Set REQUIRED=true after both targets work.
CONTENT_SYNC_REQUIRED=false
CONTENT_GITHUB_TOKEN=
CONTENT_GITHUB_OWNER=kaiyasi
CONTENT_GITHUB_REPO=Blog
CONTENT_GITHUB_BRANCH=main
CONTENT_GITLAB_TOKEN=
CONTENT_GITLAB_BASE_URL=https://gitlab.serelix.xyz
CONTENT_GITLAB_PROJECT=Kaiyasi/given
CONTENT_GITLAB_BRANCH=main

# Discord OAuth for comment avatars. Register this exact callback URL in Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
