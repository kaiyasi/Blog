# Shared by mascot dialogue and incremental article translation.
# Keep the base URL and models fixed; rotate only AI_API_KEY when needed.
AI_BASE_URL=https://ai.kot.gg/v1
AI_MODEL=gpt-5.5
AI_API_KEY=
AI_MASCOT_REASONING_EFFORT=low
AI_TRANSLATION_MODEL=gpt-5.5

# Persistent SQLite file used by comments and private friend requests.
# Mount this path on durable storage in production.
COMMUNITY_DB_PATH=./data/community.sqlite
COMMUNITY_SESSION_SECRET=

# Private administration. ADMIN_ENTRY_PATH should be a hard-to-guess URL path.
# The public mascot interaction grants a short-lived ticket before this route can open.
# Use a unique password and a random secret of at least 32 characters.
ADMIN_ENTRY_PATH=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional writable, persistent directory for browser-authored Markdown posts.
# Defaults to ./src/content/posts.
CONTENT_POSTS_DIRECTORY=

# Discord OAuth for comment avatars. Register this exact callback URL in Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
