---
const year = new Date().getFullYear();
---
<footer class="site-footer" id="site-footer">
  <div class="footer-inner">
    <a class="footer-brand" href="/"><strong>Kai<span>yasi</span></strong><small>GIVEN / PERSONAL LOG</small></a>
    <nav class="footer-nav" aria-label="Footer navigation">
      <a href="/posts">Posts</a>
      <a href="/projects">Projects</a>
      <a href="/about">About</a>
      <a href="https://github.com/kaiyasi" target="_blank" rel="noopener">GitHub</a>
      <a href="/rss.xml">RSS</a>
    </nav>
    <span class="footer-year">© {year}</span>
  </div>
  <p class="footer-disclaimer">GIVEN-inspired unofficial fan work. Not affiliated with the original rights holders.</p>
</footer>
<style>
.site-footer { position: relative; z-index: 1; overflow: hidden; margin-top: auto; border-top: 1px solid var(--chrome-border); color: var(--text); background: var(--chrome-surface); }
.site-footer::before, .site-footer::after { content: ''; position: absolute; z-index: 1; top: 0; height: 3px; pointer-events: none; }
.site-footer::before { left: 0; width: 36%; background: var(--accent); }
.site-footer::after { right: 0; left: 36%; background: var(--accent-secondary); opacity: .72; }
.footer-inner { position: relative; width: min(1160px, 100%); min-height: 118px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 3rem; margin: 0 auto; padding: 1.8rem 1.5rem; }
.footer-brand { display: flex; align-items: baseline; gap: .8rem; }
.footer-brand strong { color: var(--text); font: 600 1.25rem/.9 var(--font-ui); }
.footer-brand strong span { color: var(--accent); }
.footer-brand small { color: var(--text-faint); font: 500 .46rem var(--font-mono); }
.footer-nav { justify-self: center; display: flex; gap: 1.5rem; }
.footer-nav a { padding: .3rem 0; border-bottom: 1px solid transparent; color: var(--text-muted); font: 500 .66rem var(--font-ui); }
.footer-nav a:hover, .footer-nav a:focus-visible { color: var(--accent); border-bottom-color: var(--accent); }
.footer-year { color: var(--text-faint); font: 400 .5rem var(--font-mono); }
.footer-disclaimer { position: relative; padding: .55rem max(1.5rem, calc((100vw - 1112px) / 2)); border-top: 1px solid var(--chrome-border); color: var(--text-faint); background: var(--chrome-control); font: 400 .46rem var(--font-mono); }
@media (max-width: 700px) {
  .footer-inner { min-height: 142px; grid-template-columns: 1fr auto; gap: 1rem; padding: 1.6rem 1.25rem; }
  .footer-brand { display: block; }
  .footer-brand small { display: block; margin-top: .4rem; }
  .footer-nav { grid-column: 1 / -1; grid-row: 2; justify-self: start; flex-wrap: wrap; gap: .4rem 1.1rem; }
  .footer-year { grid-column: 2; grid-row: 1; }
  .footer-disclaimer { padding: .65rem 1.25rem; line-height: 1.5; }
}
</style>
