<div class="print-frame" aria-hidden="true">
  <span>GIVEN / KAIYASI / 07</span>
  <i></i><i></i><i></i><i></i>
</div>
<canvas id="global-canvas" class="global-canvas" aria-hidden="true"></canvas>

<style>
.global-canvas {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
}
.print-frame { position: fixed; inset: 64px 0 0; z-index: 2; pointer-events: none; }
.print-frame::before { content: ''; position: absolute; left: 0; top: 16%; width: 7px; height: 22%; background: var(--accent); opacity: .72; }
.print-frame::after { content: ''; position: absolute; right: 0; bottom: 14%; width: 6px; height: 26%; background: var(--accent-secondary); opacity: .62; }
.print-frame span { position: absolute; left: 9px; top: 43%; color: var(--text-faint); font: 500 .45rem var(--font-mono); writing-mode: vertical-rl; opacity: .72; }
.print-frame i { position: absolute; width: 13px; height: 13px; border-color: var(--accent); opacity: .55; }
.print-frame i:nth-of-type(1) { top: 18px; left: 18px; border-top: 1px solid; border-left: 1px solid; }
.print-frame i:nth-of-type(2) { top: 18px; right: 18px; border-top: 1px solid; border-right: 1px solid; }
.print-frame i:nth-of-type(3) { bottom: 18px; left: 18px; border-bottom: 1px solid; border-left: 1px solid; }
.print-frame i:nth-of-type(4) { right: 18px; bottom: 18px; border-right: 1px solid; border-bottom: 1px solid; }
@media (max-width: 700px) {
  .print-frame { display: none; }
}
</style>

<script>
(function () {
  const canvas = document.getElementById('global-canvas') as HTMLCanvasElement;
  if (!canvas || (canvas as any).__sceneRunning) return;
  (canvas as any).__sceneRunning = true;

  const ctx = canvas.getContext('2d')!;
  let animation = 0;
  let theme = '';
  let scene = '';
  let marks: { x: number; y: number; speed: number; phase: number; size: number }[] = [];
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function width() { return canvas.offsetWidth; }
  function height() { return canvas.offsetHeight; }
  function currentTheme() { return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light'; }
  function currentScene() { return document.documentElement.dataset.scene || 'campus'; }

  function resize() {
    const dpr = devicePixelRatio || 1;
    canvas.width = width() * dpr;
    canvas.height = height() * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function reset() {
    theme = currentTheme();
    scene = currentScene();
    marks = Array.from({ length: theme === 'light' ? 14 : 16 }, () => ({
      x: Math.random() * width(),
      y: Math.random() * height(),
      speed: 0.08 + Math.random() * 0.14,
      phase: Math.random() * Math.PI * 2,
      size: 5 + Math.random() * 7,
    }));
  }

  function drawStaff() {
    ctx.strokeStyle = theme === 'dark' ? 'rgba(242, 241, 237, 0.055)' : 'rgba(23, 24, 26, 0.052)';
    ctx.lineWidth = 1;
    for (let group = 54; group < height(); group += 132) {
      for (let line = 0; line < 5; line++) {
        ctx.beginPath();
        ctx.moveTo(0, group + line * 7);
        ctx.lineTo(width(), group + line * 7);
        ctx.stroke();
      }
    }
  }

  function drawWaveform() {
    ctx.strokeStyle = theme === 'dark' ? 'rgba(80, 183, 220, 0.075)' : 'rgba(45, 130, 158, 0.065)';
    ctx.lineWidth = 1;
    for (let row = 90; row < height(); row += 180) {
      ctx.beginPath();
      for (let x = 0; x <= width(); x += 12) {
        const y = row + Math.sin(x * 0.018 + row) * 7 + Math.sin(x * 0.043) * 3;
        x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.stroke();
    }
  }

  function drawPick(mark: typeof marks[number], alpha: number) {
    ctx.save();
    ctx.translate(mark.x, mark.y);
    ctx.rotate(Math.sin(mark.phase) * .16);
    ctx.strokeStyle = theme === 'dark' ? `rgba(225, 174, 57, ${alpha})` : `rgba(214, 161, 38, ${alpha})`;
    ctx.beginPath();
    ctx.moveTo(0, -mark.size);
    ctx.quadraticCurveTo(mark.size, -mark.size * .5, mark.size * .72, mark.size * .38);
    ctx.quadraticCurveTo(0, mark.size * 1.2, -mark.size * .72, mark.size * .38);
    ctx.quadraticCurveTo(-mark.size, -mark.size * .5, 0, -mark.size);
    ctx.stroke();
    ctx.restore();
  }

  function drawToneRails() {
    const accent = theme === 'dark' ? 'rgba(88, 185, 217, .12)' : 'rgba(219, 73, 61, .1)';
    const secondary = theme === 'dark' ? 'rgba(225, 90, 76, .09)' : 'rgba(45, 130, 158, .085)';
    for (let y = 22; y < height(); y += 18) {
      ctx.fillStyle = accent;
      ctx.beginPath();
      ctx.arc(18, y, 1.4, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = secondary;
      ctx.beginPath();
      ctx.arc(width() - 18, y + 8, 1.2, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.fillStyle = accent;
    ctx.fillRect(0, 96, 4, 118);
    ctx.fillStyle = secondary;
    ctx.fillRect(width() - 3, Math.max(280, height() * .55), 3, 156);
  }

  function draw() {
    ctx.clearRect(0, 0, width(), height());
    drawToneRails();
    if (scene === 'campus' || scene === 'weekend') drawStaff();
    if (scene === 'stage') drawWaveform();

    marks.forEach(mark => {
      mark.phase += reducedMotion.matches ? 0 : mark.speed * 0.01;
      if (!reducedMotion.matches) mark.y += mark.speed;
      if (mark.y > height() + 10) mark.y = -10;
      const alpha = 0.045 + (Math.sin(mark.phase) + 1) * 0.025;
      if (scene === 'weekend') {
        drawPick(mark, alpha * .7);
      } else if (scene === 'campus') {
        ctx.fillStyle = theme === 'dark' ? `rgba(237, 116, 104, ${alpha})` : `rgba(219, 73, 61, ${alpha})`;
        ctx.fillRect(mark.x, mark.y, mark.size * 1.3, 1);
        ctx.fillRect(mark.x, mark.y - 3, 1, 7);
      } else {
        ctx.strokeStyle = `rgba(80, 183, 220, ${alpha + 0.025})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(mark.x, mark.y, mark.size * .5, 0, Math.PI * 2);
        ctx.stroke();
      }
    });
    animation = requestAnimationFrame(draw);
  }

  new MutationObserver(() => {
    if (theme !== currentTheme() || scene !== currentScene()) reset();
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'data-scene'] });
  window.addEventListener('resize', () => { resize(); reset(); });
  resize();
  reset();
  cancelAnimationFrame(animation);
  draw();
})();
</script>
