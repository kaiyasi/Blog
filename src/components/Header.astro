---
import { localeLabels, locales, messages } from '../i18n';

const nav = [
  { key: 'nav.posts', href: '/posts' },
  { key: 'nav.projects', href: '/projects' },
  { key: 'nav.about', href: '/about' },
];
const { pathname } = Astro.url;
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Kaiyasi home" data-mascot-nav="home">
      <span class="logo-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="logo-name">Kaiyasi</span>
      <span class="logo-edition">Blog</span>
    </a>
    <span class="header-issue" aria-hidden="true">VOL.07 / PERSONAL LOG</span>
    <nav class="nav" aria-label="Main navigation">
      {nav.map((item, index) => (
        <a href={item.href} class:list={['nav-link', { active: pathname.startsWith(item.href) }]} data-mascot-nav={item.key.replace('nav.', '')}>
          <small>0{index + 1}</small>
          <span data-i18n={item.key}>{messages['zh-TW'][item.key]}</span>
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <button class="icon-btn" id="search-trigger" aria-label="Search" data-i18n-aria="actions.search" title="Search" data-mascot-control="search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
      </button>
      <div class="language-control">
        <button class="icon-btn" id="language-trigger" aria-label="Change language" aria-haspopup="menu" aria-expanded="false" title="Language" data-mascot-control="language">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9S14.5 18.5 12 21M12 3C9.5 5.5 8.2 8.5 8.2 12s1.3 6.5 3.8 9"/></svg>
        </button>
        <div class="language-menu" id="language-menu" role="menu" hidden>
          {locales.map(locale => (
            <button type="button" role="menuitemradio" aria-checked={locale === 'zh-TW' ? 'true' : 'false'} data-locale-option={locale} onclick={`window.setLocale('${locale}')`}>
              <span>{localeLabels[locale]}</span><span class="locale-code">{locale}</span>
            </button>
          ))}
        </div>
      </div>
      <button class="icon-btn theme-toggle" id="theme-toggle" aria-label="Toggle color theme" title="Theme" onclick="window.toggleTheme()" data-mascot-control="theme">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"/></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
function initHeader() {
  const trigger = document.getElementById('language-trigger');
  const menu = document.getElementById('language-menu');
  if (!trigger || !menu || trigger.dataset.bound === 'true') return;
  trigger.dataset.bound = 'true';
  trigger.addEventListener('click', event => {
    event.stopPropagation();
    const open = menu.hasAttribute('hidden');
    menu.toggleAttribute('hidden', !open);
    trigger.setAttribute('aria-expanded', String(open));
  });
  menu.addEventListener('click', () => {
    menu.setAttribute('hidden', '');
    trigger.setAttribute('aria-expanded', 'false');
  });
  document.addEventListener('click', event => {
    if (!menu.contains(event.target as Node) && event.target !== trigger) {
      menu.setAttribute('hidden', '');
      trigger.setAttribute('aria-expanded', 'false');
    }
  });
}
initHeader();
document.addEventListener('astro:page-load', initHeader);
</script>

<style>
.site-header { position: fixed; inset: 0 0 auto; z-index: 200; border-bottom: 1px solid var(--chrome-border); background: var(--chrome-surface); box-shadow: 0 4px 0 color-mix(in srgb, var(--accent-secondary) 16%, transparent); transition: background var(--transition-slow), border-color var(--transition-slow); }
.site-header::before, .site-header::after { content: ''; position: absolute; top: 0; height: 3px; pointer-events: none; }
.site-header::before { left: 0; width: 36%; background: var(--accent); }
.site-header::after { left: 36%; right: 0; background: var(--accent-secondary); opacity: .72; }
.header-inner { position: relative; width: min(1160px, 100%); height: 68px; margin: 0 auto; padding: 3px 1.5rem 0; display: flex; align-items: center; gap: 0; }
.logo { align-self: stretch; display: flex; align-items: center; gap: .55rem; flex-shrink: 0; margin-left: -1.5rem; padding: 0 1.2rem; color: var(--on-accent); background: var(--accent); font: 600 .92rem var(--font-ui); letter-spacing: 0; }
.logo-mark { width: 22px; display: flex; flex-direction: column; gap: 4px; transform: rotate(-8deg); }
.logo-mark i { display: block; height: 2px; background: currentColor; }
.logo-mark i:nth-child(2) { width: 12px; }
.logo-edition { padding-left: .55rem; border-left: 1px solid color-mix(in srgb, currentColor 48%, transparent); color: currentColor; font: 600 .58rem var(--font-mono); }
.header-issue { align-self: stretch; display: flex; align-items: center; padding: 0 1.1rem; border-right: 1px solid var(--chrome-border); color: var(--text-faint); font: 500 .52rem var(--font-mono); }
.nav { align-self: stretch; margin-left: auto; display: flex; }
.nav-link { position: relative; min-width: 86px; display: flex; flex-direction: column; justify-content: center; gap: .12rem; padding: .35rem .85rem; border-left: 1px solid var(--chrome-border); color: var(--text-muted); font: 500 .68rem var(--font-mono); border-radius: 0; letter-spacing: 0; text-transform: uppercase; }
.nav-link small { color: var(--accent); font: 600 .48rem var(--font-mono); }
.nav-link::after { content: ''; position: absolute; right: 0; bottom: 0; left: 0; height: 4px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform var(--transition); }
.nav-link:hover { color: var(--text); background: color-mix(in srgb, var(--accent) 8%, transparent); }
.nav-link:hover::after, .nav-link.active::after { transform: scaleX(1); }
.nav-link.active { color: var(--accent); }
.header-actions { align-self: stretch; display: flex; align-items: center; gap: 4px; padding-left: .5rem; border-left: 1px solid var(--chrome-border); }
.icon-btn { width: 36px; height: 36px; display: grid; place-items: center; border: 1px solid var(--chrome-border); border-radius: 2px; color: var(--text-muted); background: var(--chrome-control); cursor: pointer; transition: color var(--transition), border-color var(--transition), background var(--transition), transform var(--transition); }
.icon-btn:hover { color: var(--accent); border-color: var(--accent); background: var(--accent-glow); transform: translateY(-2px); }
.icon-btn:active { color: var(--on-accent); border-color: var(--accent); background: var(--accent); transform: translateY(0); }
.icon-btn[aria-expanded='true'], .theme-toggle[aria-pressed='true'] { color: var(--accent); border-color: var(--accent); background: var(--accent-glow); }
.language-control { position: relative; }
.language-menu { position: absolute; right: 0; top: 42px; width: 184px; padding: .35rem; background: var(--chrome-surface); border: 1px solid var(--chrome-border); border-radius: var(--radius-md); box-shadow: 0 14px 40px rgba(0,0,0,.16); }
.language-menu[hidden] { display: none; }
.language-menu button { width: 100%; min-height: 38px; display: flex; align-items: center; justify-content: space-between; padding: .45rem .55rem; border: 1px solid transparent; border-radius: 2px; background: transparent; color: var(--text); font: 400 .8rem var(--font-ui); cursor: pointer; }
.language-menu button:hover, .language-menu button[aria-checked='true'] { border-color: var(--accent); background: var(--accent-glow); color: var(--accent); }
.locale-code { color: var(--text-faint); font: 400 .65rem var(--font-mono); }
.icon-moon { display: none; }
:global([data-theme='dark']) .icon-sun { display: none; }
:global([data-theme='dark']) .icon-moon { display: block; }
:global([data-theme='dark']) .theme-toggle { color: var(--accent); border-color: var(--accent); background: var(--accent-glow); }
@media (max-width: 650px) {
  .header-inner { height: 96px; padding: 3px 0 0; display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: 49px 44px; }
  .logo { grid-column: 1; grid-row: 1; margin-left: 0; padding: 0 .9rem; }
  .logo-name { display: inline; }
  .logo-edition { padding-left: .45rem; }
  .header-issue { display: none; }
  .nav { grid-column: 1 / -1; grid-row: 2; align-self: stretch; width: 100%; margin-left: 0; border-top: 1px solid var(--chrome-border); }
  .nav-link { min-width: 0; flex: 1; flex-direction: row; align-items: center; justify-content: center; gap: .45rem; padding: 0 .5rem; font-size: .67rem; }
  .nav-link:first-child { border-left: 0; }
  .nav-link small { font-size: .44rem; }
  .nav-link::after { height: 3px; }
  .header-actions { grid-column: 2; grid-row: 1; gap: 3px; padding: 0 .55rem; border-left: 0; }
  .icon-btn { width: 34px; height: 34px; }
}
@media (max-width: 360px) {
  .logo { padding: 0 .7rem; }
  .logo-name { font-size: .82rem; }
  .logo-edition { display: none; }
  .nav-link { padding: 0 .3rem; font-size: .62rem; }
  .header-actions { padding: 0 .4rem; }
  .icon-btn { width: 32px; }
}
</style>
