---
import eventConfig from '../config/mascot-events.json';

const assetNames = {
  campus: { mafuyu: 'mafuyu-campus.png', ritsuka: 'ritsuka-campus.png' },
  stage: { mafuyu: 'mafuyu-stage.png', ritsuka: 'ritsuka-stage.png' },
  weekend: { mafuyu: 'mafuyu-weekend.png', ritsuka: 'ritsuka-weekend.png' },
} as const;

const assets = Object.fromEntries(Object.entries(assetNames).map(([scene, pair]) => [
  scene,
  Object.fromEntries(Object.entries(pair).map(([character, filename]) => [
    character,
    `/images/mascots/${filename}`,
  ])),
]));
const isHome = Astro.url.pathname === '/';
const enabled = Astro.url.pathname !== '/mascots';
---

<aside class="mascot-dock" id="mascot-dock" data-assets={JSON.stringify(assets)} data-events={JSON.stringify(eventConfig)} data-character="mafuyu" data-visible={String(!isHome)} data-enabled={String(enabled)} aria-label="GIVEN mascots" aria-hidden={String(isHome)} inert={isHome}>
  <div class="mascot-dialog" id="mascot-dialog" role="status" aria-live="polite" data-state="idle" hidden>
    <div class="dialog-copy">
      <p id="mascot-message"></p>
    </div>
    <button type="button" class="dialog-close" id="mascot-dialog-close" aria-label="關閉對話" title="關閉">&times;</button>
  </div>
  <div class="mascot-slot">
    <button type="button" class="mascot mascot-mafuyu" data-mascot="mafuyu" aria-label="和真冬互動">
      <img src="/images/mascots/mafuyu-campus.png" alt="" width="1024" height="1536" decoding="async" />
    </button>
    <button type="button" class="mascot mascot-ritsuka" data-mascot="ritsuka" aria-label="和立夏互動" hidden>
      <img src="/images/mascots/ritsuka-campus.png" alt="" width="1024" height="1536" decoding="async" />
    </button>
  </div>
  <span class="mascot-action" aria-hidden="true"><i></i><i></i><i></i></span>
</aside>

<script src="../scripts/mascot-chat.ts"></script>

<style>
  .mascot-dock { position: fixed; z-index: 150; bottom: 0; width: 150px; height: 250px; opacity: 0; pointer-events: none; transform: translateY(28px); transition: opacity 280ms ease, transform 360ms ease; }
  .mascot-dock[data-visible='true'] { opacity: 1; transform: translateY(0); }
  :global([data-theme='light']) .mascot-dock { left: max(1rem, env(safe-area-inset-left)); right: auto; }
  :global([data-theme='dark']) .mascot-dock { right: max(1rem, env(safe-area-inset-right)); left: auto; }
  .mascot-slot { position: absolute; inset: auto 0 0; height: 210px; }
  .mascot { position: absolute; bottom: 0; left: 0; width: 132px; height: 210px; padding: 0; border: 0; background: transparent; cursor: pointer; pointer-events: auto; transform-origin: 50% 100%; filter: saturate(.92); transition: filter 180ms ease, transform 180ms ease; }
  .mascot[hidden] { display: none !important; }
  .mascot-dock[data-visible='false'] .mascot { pointer-events: none; }
  .mascot:hover, .mascot:focus-visible { z-index: 2; filter: saturate(1.04); transform: translateY(-4px); }
  .mascot:focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .mascot img { width: 100%; height: 100%; object-fit: contain; object-position: bottom; }
  .mascot-action { position: absolute; z-index: 3; right: 2px; bottom: 148px; width: 32px; height: 25px; display: flex; align-items: center; justify-content: center; gap: 3px; border: 1px solid color-mix(in srgb, var(--text) 72%, transparent); border-radius: 7px; color: var(--text); background: var(--bg-surface); box-shadow: 2px 2px 0 color-mix(in srgb, var(--accent) 58%, transparent); pointer-events: none; animation: action-float 2.4s ease-in-out infinite; }
  .mascot-action::after { content: ''; position: absolute; left: 5px; bottom: -5px; width: 7px; height: 7px; border-right: 1px solid color-mix(in srgb, var(--text) 72%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--text) 72%, transparent); background: var(--bg-surface); transform: rotate(45deg); }
  .mascot-action i { width: 3px; height: 3px; border-radius: 50%; background: currentColor; }
  .mascot-dock:has(.mascot:hover) .mascot-action { color: var(--on-accent); border-color: var(--accent); background: var(--accent); transform: translateY(-3px); }

  .mascot-dialog { position: absolute; z-index: 4; left: 88px; bottom: 188px; width: min(280px, calc(100vw - 8rem)); min-height: 78px; display: grid; grid-template-columns: minmax(0, 1fr) 24px; gap: .65rem; align-items: start; padding: .75rem .7rem .8rem .9rem; border: 1px solid color-mix(in srgb, var(--text) 52%, var(--border)); border-radius: 8px; color: var(--text); background: color-mix(in srgb, var(--bg-surface) 98%, var(--accent) 2%); box-shadow: 0 8px 26px color-mix(in srgb, var(--text) 13%, transparent), 3px 3px 0 color-mix(in srgb, var(--accent) 38%, transparent); pointer-events: auto; transform-origin: 24px calc(100% + 10px); animation: bubble-in 180ms ease-out both; }
  :global([data-theme='dark']) .mascot-dialog { right: 88px; left: auto; box-shadow: 0 8px 26px color-mix(in srgb, #000 34%, transparent), -3px 3px 0 color-mix(in srgb, var(--accent) 38%, transparent); transform-origin: calc(100% - 24px) calc(100% + 10px); }
  .mascot-dialog::before { content: ''; position: absolute; top: 0; right: 14px; left: 14px; height: 2px; background: linear-gradient(90deg, transparent, var(--accent), transparent); opacity: .72; }
  .mascot-dialog::after { content: ''; position: absolute; left: 25px; bottom: -7px; width: 13px; height: 13px; border-right: 1px solid color-mix(in srgb, var(--text) 52%, var(--border)); border-bottom: 1px solid color-mix(in srgb, var(--text) 52%, var(--border)); background: color-mix(in srgb, var(--bg-surface) 98%, var(--accent) 2%); transform: rotate(45deg); }
  :global([data-theme='dark']) .mascot-dialog::after { right: 25px; left: auto; }
  .mascot-dialog[hidden] { display: none; }
  .mascot-dialog p { margin: 0; color: var(--text-muted); font: 430 .84rem/1.52 var(--font-ui); letter-spacing: 0; }
  .mascot-dialog[data-state='loading'] p { min-height: 1.25rem; }
  .mascot-dialog[data-state='loading'] p::after { content: '...'; display: inline-block; color: var(--accent); font: 700 .9rem var(--font-mono); letter-spacing: 0; animation: voice-loading 1s steps(3, end) infinite; overflow: hidden; width: 1.5rem; }
  .mascot-dialog[data-state='error'] { border-color: color-mix(in srgb, var(--accent-secondary) 64%, var(--border)); }
  .mascot-dialog[data-state='error'] p { color: var(--text-faint); font-family: var(--font-mono); font-size: .64rem; }
  .dialog-close { width: 24px; height: 24px; margin: -.3rem -.3rem 0 0; border: 0; border-radius: 4px; color: var(--text-faint); background: transparent; font: 400 1.05rem/1 var(--font-ui); cursor: pointer; }
  .dialog-close:hover, .dialog-close:focus-visible { color: var(--text); background: var(--bg-muted); }

  .mascot.reaction-nod { animation: reaction-nod 560ms ease; }
  .mascot.reaction-jump { animation: reaction-jump 620ms ease; }
  .mascot.reaction-sway { animation: reaction-sway 680ms ease; }
  .mascot.reaction-startled { animation: reaction-startled 520ms ease; }
  @keyframes bubble-in { from { opacity: 0; transform: translateY(8px) scale(.96); } to { opacity: 1; transform: none; } }
  @keyframes voice-loading { 0% { width: .4rem; } 100% { width: 1.5rem; } }
  @keyframes action-float { 50% { transform: translateY(-4px); } }
  @keyframes reaction-nod { 35% { transform: translateY(2px) rotate(1.5deg); } 70% { transform: translateY(-4px) rotate(-1deg); } }
  @keyframes reaction-jump { 35% { transform: translateY(-13px); } 62% { transform: translateY(-2px); } 78% { transform: translateY(-6px); } }
  @keyframes reaction-sway { 30% { transform: rotate(-3deg); } 65% { transform: rotate(2deg); } }
  @keyframes reaction-startled { 20% { transform: translateY(-10px) rotate(-3deg); } 48% { transform: translateY(-5px) rotate(3deg); } 74% { transform: translateY(-2px) rotate(-1deg); } }

  @media (max-width: 700px) {
    .mascot-dock { width: 60px; height: 102px; }
    :global([data-theme='light']) .mascot-dock { left: max(.25rem, env(safe-area-inset-left)); }
    :global([data-theme='dark']) .mascot-dock { right: max(.25rem, env(safe-area-inset-right)); }
    .mascot-slot { height: 86px; }
    .mascot { width: 54px; height: 86px; }
    .mascot-action { right: 0; bottom: 58px; width: 23px; height: 19px; }
    .mascot-dialog { left: 38px; bottom: 81px; width: min(230px, calc(100vw - 48px)); min-height: 72px; padding: .68rem .62rem .72rem .75rem; }
    :global([data-theme='dark']) .mascot-dialog { right: 38px; left: auto; }
    .mascot-dialog p { font-size: .78rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mascot, .mascot-action, .mascot-dialog { transition: none; animation: none; }
  }
</style>
