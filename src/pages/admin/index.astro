<style is:global>
  /* Keep the admin navigation in the same visual family as the public header. */
  .admin-shell > .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    min-height: 68px;
    height: 68px;
    display: block;
    padding: 0;
    border-bottom: 1px solid rgba(255, 255, 255, .13);
