---
import { adminConfigured, isAdminAuthenticated } from '../../server/admin-auth';
import '../../styles/global.css';

export const prerender = false;

const configured = adminConfigured();
const authenticated = isAdminAuthenticated(Astro.request);
const entryPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-TW" data-admin-theme="soft">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#101415" />
    <link rel="icon" type="image/png" sizes="256x256" href="/admin-favicon-specialized-v2.png?v=3" />
    <title>管理後台 - Kaiyasi</title>
    <script is:inline>
      try { document.documentElement.dataset.adminTheme = localStorage.getItem('kaiyasi-admin-theme') === 'dark' ? 'dark' : 'soft'; } catch {}
    </script>
  </head>
  <body>
    <main class="desktop-required" aria-labelledby="desktop-required-title">
      <div class="desktop-required-mark" aria-hidden="true"><i></i><i></i><i></i></div>
      <p>ADMIN / DESKTOP ONLY</p>
      <h1 id="desktop-required-title">請使用桌面裝置</h1>
      <a href="/">返回網站</a>
    </main>
    {!authenticated ? (
      <main class="login-page">
        <section class="login-panel" aria-labelledby="login-title">
          <header>
            <a href="/" class="brand" aria-label="返回 Kaiyasi 網站">
              <span class="login-brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
              <strong>KAIYASI</strong>
              <span class="login-brand-edition">/ ADMIN</span>
            </a>
            <div class="login-header-tools">
              <p>PRIVATE CONTROL ROOM</p>
              <button type="button" class="toolbar-control theme-control-button" role="switch" aria-checked="false" aria-label="切換為深色模式" title="切換為深色模式" data-tooltip="深色模式" data-admin-theme-toggle>
                <svg class="theme-icon theme-icon-soft" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"/></svg>
                <svg class="theme-icon theme-icon-dark" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"/></svg>
              </button>
            </div>
          </header>
          <div class="login-copy">
            <small>AUTHENTICATION / 01</small>
            <h1 id="login-title">管理員登入</h1>
            <p>登入後可以在網站撰寫文章，並管理文章與留言。</p>
          </div>
          {configured ? (
            <form data-login-form>
              <label>
                <span>管理密碼</span>
                <input name="password" type="password" autocomplete="current-password" maxlength="256" required autofocus />
              </label>
              <footer>
                <p data-login-status role="status"></p>
                <button type="submit">登入 <b aria-hidden="true">→</b></button>
              </footer>
            </form>
          ) : (
            <div class="setup-state" role="status">
              <strong>後台尚未啟用</strong>
              <p>請設定 <code>ADMIN_PASSWORD</code>，以及至少 32 字元的 <code>ADMIN_SESSION_SECRET</code> 或 <code>COMMUNITY_SESSION_SECRET</code>。</p>
            </div>
          )}
        </section>
      </main>
    ) : (
      <div class="admin-shell" data-admin-app>
        <header class="topbar">
          <div class="topbar-inner">
            <a href={entryPath} class="admin-brand" aria-label="Kaiyasi 管理後台首頁">
              <span class="admin-brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="admin-brand-name">Kaiyasi</span>
              <span class="admin-brand-edition">ADMIN</span>
            </a>
            <nav aria-label="後台功能">
              <button type="button" aria-current="page" data-view-target="posts"><small>01</small><span>文章</span></button>
              <button type="button" data-view-target="projects"><small>02</small><span>專案</span></button>
              <button type="button" data-view-target="about"><small>03</small><span>關於</span></button>
              <button type="button" data-view-target="comments"><small>04</small><span>留言</span></button>
            </nav>
            <div class="topbar-actions" aria-label="後台工具">
              <button type="button" class="toolbar-control theme-control-button" role="switch" aria-checked="false" aria-label="切換為深色模式" title="切換為深色模式" data-tooltip="深色模式" data-admin-theme-toggle>
                <svg class="theme-icon theme-icon-soft" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"/></svg>
                <svg class="theme-icon theme-icon-dark" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"/></svg>
              </button>
              <a href="/" class="toolbar-control site-control" aria-label="返回網站" title="返回網站" data-tooltip="返回網站">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m3 10 9-7 9 7"/><path d="M5 9v11h14V9M9 20v-6h6v6"/></svg>
              </a>
              <button type="button" class="toolbar-control logout-control" data-logout aria-label="登出" title="登出" data-tooltip="登出">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10 17l5-5-5-5M15 12H3"/><path d="M14 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-5"/></svg>
              </button>
            </div>
          </div>
        </header>

        <main class="workspace">
          <section data-admin-view="posts">
            <header class="workspace-header">
              <div><p>CONTENT / POSTS</p><h1>文章管理</h1></div>
              <button type="button" class="command-button" data-new-post><span aria-hidden="true">＋</span> 新增文章</button>
            </header>

            <div class="post-workspace">
              <aside class="post-index" aria-labelledby="post-index-title">
                <header><h2 id="post-index-title">所有文章</h2><span data-post-count>0</span></header>
                <div class="post-index-controls">
                  <label class="post-search"><span class="sr-only">搜尋文章</span><input type="search" placeholder="搜尋標題、slug 或標籤" data-post-search /></label>
                  <label><span class="sr-only">文章狀態</span><select data-post-state><option value="all">全部</option><option value="published">已發布</option><option value="draft">草稿</option></select></label>
                </div>
                <p class="manager-status" data-post-list-status role="status">正在載入文章...</p>
                <div class="post-list" data-post-list></div>
                <footer class="post-pagination" aria-label="文章分頁">
                  <button type="button" data-post-page="previous" aria-label="上一頁" title="上一頁">←</button>
                  <span><b data-post-page-current>1</b> / <span data-post-page-total>1</span></span>
                  <button type="button" data-post-page="next" aria-label="下一頁" title="下一頁">→</button>
                </footer>
              </aside>

              <form class="post-editor" data-post-form>
                <header>
                  <div><small data-editor-mode>NEW DOCUMENT</small><h2 data-editor-title>新增文章</h2></div>
                  <div class="editor-header-actions">
                    <div class="editor-tabs" aria-label="文章檢視模式">
                      <button type="button" aria-pressed="true" data-editor-tab="edit">編輯</button>
                      <button type="button" aria-pressed="false" data-editor-tab="preview">預覽</button>
                    </div>
                    <a class="preview-link" data-post-preview target="_blank" rel="noopener" hidden>正式頁面 ↗</a>
                  </div>
                </header>
                <div class="editor-fields">
                  <label class="wide"><span>文章標題</span><input name="title" maxlength="160" required /></label>
                  <label><span>SLUG</span><input name="slug" maxlength="160" pattern="[a-z0-9][a-z0-9/-]*" required /></label>
                  <label><span>發布日期</span><input name="date" type="date" required /></label>
                  <label class="wide"><span>摘要</span><textarea name="description" rows="2" maxlength="500" required></textarea></label>
                  <label class="wide"><span>標籤 <i>用逗號分隔</i></span><input name="tags" placeholder="Astro, Life, Music" /></label>
                  <label class="wide"><span>封面路徑 <i>選填</i></span><input name="cover" placeholder="../../assets/posts/slug/cover.jpg" /></label>
                  <label class="check-field"><input name="copyright" type="checkbox" checked /><span>顯示著作權聲明</span></label>
                </div>
                <section class="markdown-editor" data-editor-panel="edit">
                  <div class="markdown-toolbar" data-markdown-toolbar aria-label="Markdown 快速工具">
                    <span class="markdown-toolbar-label">MARKDOWN</span>
                    <div class="toolbar-primary">
                      <div class="toolbar-group" aria-label="文字格式">
                        <button type="button" data-md-action="bold" title="粗體" aria-label="插入粗體"><b>B</b></button>
                        <button type="button" data-md-action="italic" title="斜體" aria-label="插入斜體"><i>I</i></button>
                        <button type="button" data-md-action="link" title="連結 [文字](網址)" aria-label="插入連結"><span class="link-mark">[ ]</span></button>
                      </div>
                      <div class="toolbar-group" aria-label="段落格式">
                        <button type="button" data-md-action="heading" title="二級標題" aria-label="插入二級標題">H2</button>
                        <button type="button" data-md-action="quote" title="引用" aria-label="插入引用">“</button>
                        <button type="button" data-md-action="unordered-list" title="項目清單" aria-label="插入項目清單">•</button>
                        <button type="button" data-md-action="ordered-list" title="編號清單" aria-label="插入編號清單">1.</button>
                      </div>
                      <div class="toolbar-group" aria-label="插入內容">
                        <button type="button" data-md-action="code" title="程式碼區塊" aria-label="插入程式碼區塊">&lt;/&gt;</button>
                        <button type="button" data-md-action="image" title="圖片" aria-label="插入圖片">▧</button>
                      </div>
                      <div class="toolbar-group toolbar-extended" aria-label="本站擴充">
                        <button type="button" data-md-action="callout" title="本站提示框" aria-label="插入提示框">:::</button>
                        <button type="button" data-md-action="embed" title="本站嵌入內容" aria-label="插入嵌入內容">▶</button>
                      </div>
                    </div>
                    <button type="button" class="syntax-button" data-syntax-open aria-expanded="false" aria-controls="syntax-reference"><span aria-hidden="true">?</span> 語法參考</button>
                  </div>
                  <label class="body-field"><span class="body-field-label">MARKDOWN 內容</span><textarea name="body" spellcheck="true" placeholder="從這裡開始寫文章..."></textarea></label>
                </section>
                <section class="preview-panel" data-editor-panel="preview" hidden aria-label="文章預覽">
                  <p data-preview-status role="status">切換到預覽後會顯示文章。</p>
                  <iframe data-preview-frame title="文章預覽" sandbox="allow-same-origin" referrerpolicy="no-referrer"></iframe>
                </section>
                <footer class="editor-actions">
                  <p data-post-save-status role="status">翻譯內容會在下次 build 時更新。</p>
                  <div>
                    <button type="submit" data-save-as="draft">儲存草稿</button>
                    <button type="submit" class="primary" data-save-as="published">發布文章</button>
                  </div>
                </footer>
              </form>
            </div>
            <aside id="syntax-reference" class="syntax-dialog syntax-drawer" data-syntax-dialog aria-labelledby="syntax-title" hidden>
              <header class="syntax-dialog-header"><div><small>EDITOR REFERENCE / MD</small><h2 id="syntax-title">寫作語法參考</h2><p>Markdown 與本站擴充格式</p></div><button type="button" data-syntax-close aria-label="關閉語法說明">×</button></header>
              <div class="syntax-layout">
                <nav class="syntax-nav" aria-label="語法分類">
                  <button type="button" aria-selected="true" data-syntax-tab="basic"><small>01</small><span>基本格式</span></button>
                  <button type="button" aria-selected="false" data-syntax-tab="links"><small>02</small><span>連結與圖片</span></button>
                  <button type="button" aria-selected="false" data-syntax-tab="extended"><small>03</small><span>本站擴充</span></button>
                </nav>
                <div class="syntax-content">
                  <section data-syntax-panel="basic">
                    <header><p>01 / BASIC</p><h3>基本 Markdown</h3></header>
                    <article class="syntax-item"><div class="syntax-item-title"><div><small>STRUCTURE</small><h4>標題</h4></div><button type="button" data-copy-syntax="syntax-heading" title="複製標題語法" aria-label="複製標題語法">⧉</button></div><p>使用井字號建立文章層級。</p><pre><code id="syntax-heading">## 二級標題
### 三級標題</code></pre></article>
                    <article class="syntax-item"><div class="syntax-item-title"><div><small>EMPHASIS</small><h4>文字強調</h4></div><button type="button" data-copy-syntax="syntax-emphasis" title="複製文字語法" aria-label="複製文字語法">⧉</button></div><p>粗體、斜體與刪除線可以混合使用。</p><pre><code id="syntax-emphasis">**粗體文字**
_斜體文字_
~~刪除文字~~</code></pre></article>
                    <article class="syntax-item"><div class="syntax-item-title"><div><small>BLOCK</small><h4>引用與程式碼</h4></div><button type="button" data-copy-syntax="syntax-block" title="複製區塊語法" aria-label="複製區塊語法">⧉</button></div><p>引用使用大於符號，程式碼使用 fence。</p><pre><code id="syntax-block">&gt; 引用內容

```js
console.log('hello');
```</code></pre></article>
                  </section>
                  <section data-syntax-panel="links" hidden>
                    <header><p>02 / LINKS</p><h3>連結與媒體</h3></header>
                    <article class="syntax-item link-anatomy"><div class="syntax-item-title"><div><small>INLINE LINK</small><h4>文字連結</h4></div><button type="button" data-copy-syntax="syntax-link" title="複製連結語法" aria-label="複製連結語法">⧉</button></div><p><span>[顯示文字]</span> 是讀者看到的內容，<b>(網址)</b> 是實際目的地。</p><pre><code id="syntax-link">[顯示文字](https://example.com)</code></pre></article>
                    <article class="syntax-item"><div class="syntax-item-title"><div><small>REFERENCE LINK</small><h4>參照式連結</h4></div><button type="button" data-copy-syntax="syntax-reference-link" title="複製參照連結" aria-label="複製參照連結">⧉</button></div><p>同一個網址重複使用時，可以集中放在文章底部。</p><pre><code id="syntax-reference-link">[顯示文字][project]

[project]: https://example.com</code></pre></article>
                    <article class="syntax-item"><div class="syntax-item-title"><div><small>LOCAL IMAGE</small><h4>文章圖片</h4></div><button type="button" data-copy-syntax="syntax-image" title="複製圖片語法" aria-label="複製圖片語法">⧉</button></div><p>圖片放在對應的 <code>src/assets/posts/slug/</code> 目錄。</p><pre><code id="syntax-image">![替代文字](../../assets/posts/文章-slug/image.jpg)</code></pre></article>
                  </section>
                  <section data-syntax-panel="extended" hidden>
                    <header><p>03 / EXTENDED</p><h3>本站擴充語法</h3></header>
                    <article class="syntax-item"><div class="syntax-item-title"><div><small>CALLOUT</small><h4>提示框</h4></div><button type="button" data-copy-syntax="syntax-callout" title="複製提示框語法" aria-label="複製提示框語法">⧉</button></div><p>支援 tip、info、warning、danger 等語氣。</p><pre><code id="syntax-callout">:::tip[提示標題]
提示內容
:::</code></pre></article>
                    <article class="syntax-item"><div class="syntax-item-title"><div><small>EMBED</small><h4>外部嵌入</h4></div><button type="button" data-copy-syntax="syntax-embed" title="複製嵌入語法" aria-label="複製嵌入語法">⧉</button></div><p>適用於 YouTube、Spotify 與其他 iframe 內容。</p><pre><code id="syntax-embed">:::embed[內容標題]&#123;src=&quot;https://...&quot; caption=&quot;內容說明&quot;&#125;
:::</code></pre></article>
                  </section>
                </div>
              </div>
            </aside>
          </section>

          <section data-admin-view="projects" hidden>
            <header class="workspace-header">
              <div><p>CONTENT / PROJECTS</p><h1>專案管理</h1></div>
              <button type="button" class="command-button" data-new-project><span aria-hidden="true">＋</span> 新增專案</button>
            </header>
            <div class="project-workspace">
              <aside class="project-index" aria-labelledby="project-index-title">
                <header><h2 id="project-index-title">公開專案</h2><span data-project-count>0</span></header>
                <label class="post-search"><span class="sr-only">搜尋專案</span><input type="search" placeholder="搜尋名稱、slug 或標籤" data-project-search /></label>
                <p class="manager-status" data-project-list-status role="status">切換至專案管理時載入。</p>
                <div class="project-list" data-project-list></div>
              </aside>
              <form class="post-editor project-editor" data-project-form>
                <header><div><small data-project-editor-mode>NEW PROJECT</small><h2 data-project-editor-title>新增專案</h2></div><div class="editor-header-actions"><div class="editor-tabs" aria-label="專案檢視模式"><button type="button" aria-pressed="true" data-project-tab="edit">編輯</button><button type="button" aria-pressed="false" data-project-tab="preview">預覽</button></div><a class="preview-link" href="/projects" target="_blank" rel="noopener">專案頁 ↗</a></div></header>
                <div data-project-panel="edit">
                <div class="editor-fields">
                  <label class="wide"><span>專案名稱</span><input name="title" maxlength="160" required /></label>
                  <label><span>SLUG</span><input name="slug" maxlength="160" pattern="[a-z0-9][a-z0-9/-]*" required /></label>
                  <label><span>完成日期</span><input name="date" type="date" required /></label>
                  <label class="wide"><span>摘要</span><textarea name="description" rows="3" maxlength="500" required></textarea></label>
                  <label><span>標籤 <i>用逗號分隔</i></span><input name="tags" placeholder="Astro, TypeScript" /></label>
                  <label class="check-field"><input name="featured" type="checkbox" /><span>列為精選專案</span></label>
                  <label class="wide"><span>網站網址 <i>選填</i></span><input name="url" type="url" placeholder="https://example.com" /></label>
                  <label class="wide"><span>GitHub 網址 <i>選填</i></span><input name="github" type="url" placeholder="https://github.com/..." /></label>
                </div>
                <label class="body-field"><span class="body-field-label">專案內容 <i>選填，支援 Markdown</i></span><textarea name="body" spellcheck="true" placeholder="記錄專案背景、技術選擇或成果..."></textarea></label>
                </div>
                <section class="project-preview-panel" data-project-panel="preview" hidden aria-label="專案預覽"><p data-project-preview-status role="status">切換到預覽後會顯示專案。</p><iframe data-project-preview-frame title="專案預覽" sandbox="allow-same-origin" referrerpolicy="no-referrer"></iframe></section>
                <footer class="editor-actions"><p data-project-save-status role="status">專案會顯示在公開的專案頁面。</p><div><button type="submit" class="primary">儲存專案</button></div></footer>
              </form>
            </div>
          </section>

          <section data-admin-view="about" hidden>
            <header class="workspace-header">
              <div><p>CONTENT / ABOUT</p><h1>關於頁面</h1></div>
              <a class="command-button about-preview-link" href="/about" target="_blank" rel="noopener">正式頁面 ↗</a>
            </header>
            <form class="post-editor about-editor" data-about-form>
              <header>
                <div><small>ABOUT DOCUMENT</small><h2>頁面內容</h2></div>
                <div class="about-header-actions">
                  <div class="editor-tabs" role="tablist" aria-label="關於頁面模式">
                    <button type="button" role="tab" aria-selected="true" data-about-tab="edit">編輯</button>
                    <button type="button" role="tab" aria-selected="false" data-about-tab="preview">預覽</button>
                  </div>
                  <button type="button" class="refresh-button" data-about-refresh aria-label="重新載入關於頁面" title="重新載入">↻</button>
                </div>
              </header>
              <div data-about-panel="edit">
                <div class="about-loading" data-about-loading role="status">正在讀取內容...</div>
                <div class="about-edit-layout" data-about-fields hidden>
                  <nav class="about-section-nav" aria-label="關於頁內容區塊">
                    <button type="button" data-about-section="profile" aria-current="page"><small>01</small><span>個人資料</span></button>
                    <button type="button" data-about-section="biography"><small>02</small><span>About Me</span></button>
                    <button type="button" data-about-section="skills"><small>03</small><span>技能</span></button>
                    <button type="button" data-about-section="roadmap"><small>04</small><span>Roadmap</span></button>
                    <button type="button" data-about-section="projects"><small>05</small><span>關於頁專案</span></button>
                    <button type="button" data-about-section="experience"><small>06</small><span>經歷</span></button>
                    <button type="button" data-about-section="connect"><small>07</small><span>聯絡方式</span></button>
                  </nav>
                  <div class="about-form-sections" data-about-section-fields></div>
                </div>
              </div>
