---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales } from '../../i18n';
const projects = (await getCollection('projects')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const translated = await getCollection('projectTranslations');
const valuesFor = (project: typeof projects[number], field: 'title'|'description') => Object.fromEntries(locales.map(locale => {
  const entry = locale === 'zh-TW' ? project : translated.find(item => item.id === `${locale}/${project.id}`);
  return [locale, entry?.data[field] ?? project.data[field]];
}));
const featured=projects.filter(p=>p.data.featured), others=projects.filter(p=>!p.data.featured);
---
<BaseLayout title="專案" titleKey="meta.projects.title" descriptionKey="meta.projects.description" bodyClass="inner-page">
  <div class="page-container projects-page">
    <header class="page-heading"><p>02 / WORK</p><h1 data-i18n="projects.title">專案</h1><span data-i18n="projects.subtitle">我做過的一些東西。</span></header>
    {featured.length>0 && <section><h2><i></i><span data-i18n="projects.featured">精選</span></h2><div class="featured-grid">{featured.map(project => <article><div class="project-top"><span>{project.data.date.getFullYear()}</span><span class="jack" aria-hidden="true"></span></div><h3 data-i18n-values={JSON.stringify(valuesFor(project,'title'))}>{project.data.title}</h3><p data-i18n-values={JSON.stringify(valuesFor(project,'description'))}>{project.data.description}</p><div class="tags">{project.data.tags.map(tag=><span>{tag}</span>)}</div><div class="project-links">{project.data.github&&<a href={project.data.github} target="_blank" rel="noopener">GitHub ↗</a>}{project.data.url&&<a href={project.data.url} target="_blank" rel="noopener">Live ↗</a>}</div></article>)}</div></section>}
    {others.length>0 && <section><h2><i></i><span data-i18n="projects.all">全部</span></h2>{others.map(project=><a class="project-row" href={project.data.url??project.data.github??'#'}><span>{project.data.date.getFullYear()}</span><strong data-i18n-values={JSON.stringify(valuesFor(project,'title'))}>{project.data.title}</strong><span>↗</span></a>)}</section>}
  </div>
</BaseLayout>
<style>
.projects-page { padding:4.5rem 1.5rem 7rem; }
.page-heading { padding-bottom:2rem; border-bottom:1px solid var(--border); }
.page-heading > p { color:var(--accent); font:500 .68rem var(--font-mono); }
h1 { margin:.6rem 0 .5rem; font-size:clamp(3rem,8vw,5.5rem); font-weight:300; }
.page-heading > span { color:var(--text-muted); font-size:.9rem; }
section { margin-top:3.5rem; }
section > h2 { display:flex; align-items:center; gap:.8rem; margin-bottom:1rem; color:var(--text-faint); font:500 .7rem var(--font-ui); text-transform:uppercase; }
section > h2 i { width:48px; height:1px; background:var(--accent); }
.featured-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(270px,1fr)); border:1px solid var(--border); }
article { min-height:280px; padding:1.5rem; background:color-mix(in srgb,var(--bg-surface) 88%,transparent); backdrop-filter:blur(8px); }
article + article { border-left:1px solid var(--border); }
.project-top { display:flex; justify-content:space-between; color:var(--text-faint); font:400 .7rem var(--font-mono); }
.jack { width:18px; height:18px; border:1px solid var(--accent); border-radius:50%; position:relative; }
.jack::after { content:''; position:absolute; inset:5px; border:1px solid var(--accent); border-radius:50%; }
h3 { margin:2.2rem 0 .6rem; font:500 1.25rem var(--font-ui); }
article p { min-height:3.6em; color:var(--text-muted); font-size:.84rem; line-height:1.6; }
.tags { display:flex; flex-wrap:wrap; gap:.35rem; margin-top:1rem; }
.tags span { padding:.12rem .42rem; border:1px solid var(--border); color:var(--text-faint); font:400 .64rem var(--font-mono); }
.project-links { display:flex; gap:1rem; margin-top:1.5rem; }
.project-links a { color:var(--accent); font:500 .75rem var(--font-ui); }
.project-row { display:grid; grid-template-columns:90px 1fr auto; padding:1rem; border-top:1px solid var(--border); color:var(--text-faint); font:400 .75rem var(--font-mono); }
.project-row:last-child { border-bottom:1px solid var(--border); }
.project-row strong { color:var(--text); font:500 .9rem var(--font-ui); }
.project-row:hover { background:var(--accent-glow); }
@media(max-width:650px) { article+article{border-left:0;border-top:1px solid var(--border)} }
</style>
